{
  "$defs": {
    "CapturedOutput": {
      "properties": {
        "n": {
          "format": "int64",
          "type": "integer"
        },
        "png": {
          "description": "The PNG's bytes, base64 encoded.",
          "type": "string"
        }
      },
      "required": [
        "n",
        "png"
      ],
      "type": "object"
    },
    "FigureOutput": {
      "properties": {
        "caption": {
          "type": "string"
        },
        "n": {
          "format": "int64",
          "type": "integer"
        },
        "svg": {
          "description": "The figure as the page drew it, where it drew it as SVG.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "n",
        "caption"
      ],
      "type": "object"
    },
    "PageOutput": {
      "properties": {
        "body": {
          "description": "The page's text.",
          "type": "string"
        },
        "figures": {
          "description": "Each figure the page draws.",
          "items": {
            "$ref": "#/$defs/FigureOutput"
          },
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/ReferenceOutput"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "description": "The address after every redirect.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "keywords",
        "body",
        "references",
        "figures"
      ],
      "type": "object"
    },
    "ReferenceOutput": {
      "properties": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "url"
      ],
      "type": "object"
    }
  },
  "description": "A page drawn in a browser and read whole.",
  "properties": {
    "captured": {
      "description": "Each figure captured as a picture; a figure that would not capture is not among them.",
      "items": {
        "$ref": "#/$defs/CapturedOutput"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/PageOutput"
    }
  },
  "required": [
    "page",
    "captured"
  ],
  "type": "object"
}
