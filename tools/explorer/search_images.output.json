{
  "$defs": {
    "Licence": {
      "description": "The licence a source states for one picture.",
      "properties": {
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Picture": {
      "description": "One picture as its engine answered it, each field the source's own statement or null.",
      "properties": {
        "creator": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "description": "The engine that answered it.",
          "type": "string"
        },
        "height": {
          "description": "The picture's height in pixels, where the source states it.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "licence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Licence"
            },
            {
              "type": "null"
            }
          ],
          "description": "The licence the source states for this picture; null where it states none."
        },
        "mediaType": {
          "type": [
            "string",
            "null"
          ]
        },
        "pageUrl": {
          "description": "The page the picture stands on; null where the engine names none.",
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "description": "The direct image address.",
          "type": "string"
        },
        "width": {
          "description": "The picture's width in pixels, where the source states it.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "url",
        "title",
        "engine"
      ],
      "type": "object"
    }
  },
  "description": "The image engines' pictures, mixed one from each engine in turn.",
  "properties": {
    "images": {
      "items": {
        "$ref": "#/$defs/Picture"
      },
      "type": "array"
    },
    "offTopic": {
      "description": "The engines whose answer did not carry the query's terms.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "unresponsive": {
      "description": "The engines that did not answer, each with why.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "images",
    "unresponsive",
    "offTopic"
  ],
  "type": "object"
}
